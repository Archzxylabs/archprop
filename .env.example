# ARCHPROP environment template
#
# Copy only the variables needed by the target environment. Never commit a
# populated .env file. Variables prefixed NEXT_PUBLIC_ are intentionally
# exposed to the browser; never place credentials in them.

# -----------------------------------------------------------------------------
# Public Arbitrum Sepolia runtime configuration (chain ID 421614)
# -----------------------------------------------------------------------------

# Public RPC endpoint. Do not use a URL containing a private credential.
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=

# Fill these only from receipt-confirmed deployment output. Never hardcode
# fallback contract addresses in application code.
NEXT_PUBLIC_ARCHPROP_REGISTRY_ADDRESS=
NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS=
NEXT_PUBLIC_OFFERING_ESCROW_ADDRESS=
NEXT_PUBLIC_REVENUE_DISTRIBUTOR_ADDRESS=
NEXT_PUBLIC_MOCK_IDR_ADDRESS=

# -----------------------------------------------------------------------------
# Supabase runtime configuration
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this value to browser code or use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Arbitrum Sepolia deployment inputs (scripts only; never browser/hosting env)
# -----------------------------------------------------------------------------

# Secret, runtime-only deployer credential. Leave empty in this committed
# template and never paste the populated value into chat, logs, or GitHub.
ARCHPROP_DEPLOYER_PRIVATE_KEY=

# Explicit deployment acknowledgement. Keep empty during checks/dry runs.
# Set to ARBITRUM_SEPOLIA_421614 only immediately before an authorized broadcast.
ARCHPROP_DEPLOY_CONFIRM=

# Role and demo actor addresses. Use nonzero checksummed EVM addresses.
# Recommended: keep deployer separate from admin. Owner may also be treasury.
ARCHPROP_ADMIN_ADDRESS=
ARCHPROP_OWNER_ADDRESS=
ARCHPROP_ISSUER_TREASURY_ADDRESS=
ARCHPROP_LEGAL_VERIFIER_ADDRESS=
ARCHPROP_VALUATION_VERIFIER_ADDRESS=
ARCHPROP_REVENUE_VERIFIER_ADDRESS=
ARCHPROP_STRUCTURER_ADDRESS=
ARCHPROP_INVESTOR_1_ADDRESS=
ARCHPROP_INVESTOR_2_ADDRESS=
